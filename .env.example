# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=twojadomena.pl,www.twojadomena.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://twojadomena.pl,https://www.twojadomena.pl

# CORS for frontend domain
CORS_ALLOWED_ORIGINS=https://twojadomena.pl,https://www.twojadomena.pl

# Database (PostgreSQL)
DATABASE_URL=postgresql://edziennik_user:strong_password@127.0.0.1:5432/edziennik
DATABASE_SSL_REQUIRE=False

# Channels / Redis
REDIS_URL=redis://127.0.0.1:6379/1

# Security (recommended for production)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
